# --- Data (pasted manually, never committed) ---
data/**
!data/README.md
!data/.gitkeep

# --- Replays (downloaded via Kaggle CLI) ---
replays/**
!replays/.gitkeep

# --- Local artifacts ---
artifacts/**
!artifacts/.gitkeep
*.pkl
*.parquet
*.feather

# --- Arena game archive (local measurement data, grows per run) ---
out/arena/

# --- Recorded local games (harness.Recorder, ~2-3 MB each and regenerable
#     with scripts/p20_record_games.py; the LB snapshot beside them is NOT
#     regenerable and stays tracked) ---
out/replays/

# --- Net checkpoints / experiment scratch (the shipped nets live in agents/sa/) ---
out/*.npz
out/e1/
out/e2/
out/e3/
out/e5/
out/emb/

# --- Built submission zips ---
dist/**
!dist/.gitkeep

# --- Engine SDK (licensed, do NOT republish; keep local only) ---
sdk/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
.ipynb_checkpoints/
.venv/
venv/
/env/
.python-version

# --- Tooling / OS ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store
Thumbs.db
*.log
*.err

# --- Kaggle creds ---
kaggle.json
.kaggle/

# gstack session artifacts
.gstack/

# --- Replay files ---
replay_miner/replays/**
replay_miner/manifests/**

# Kaggle upload staging: a 45 MB rebuildable zip of the licensed engine.
# `scripts/kaggle/pack.py` regenerates it; it must never enter git history.
out/kaggle_pack/

# Kaggle job staging + pulled outputs: regenerable, and the nets are
# large. Receipts that matter are copied into out/logs/ instead.
out/kaggle_jobs/
out/kaggle_out/
